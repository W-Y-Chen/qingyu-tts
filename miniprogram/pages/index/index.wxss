/* 主页样式 */

.hero {
  padding: 20rpx 8rpx 32rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #1F2329;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #8A9099;
}

.counter {
  font-size: 24rpx;
  font-weight: 400;
  color: #8A9099;
}

/* ---------- 文本域 ---------- */
.textarea {
  width: 100%;
  box-sizing: border-box;
  min-height: 260rpx;
  max-height: 520rpx;
  padding: 20rpx;
  background: #F7F8FA;
  border-radius: 14rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #1F2329;
}

/* ---------- 标记按钮 ---------- */
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-btn {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #F2F4FF;
  color: #4B6BFB;
  font-size: 24rpx;
}

.tag-btn-plain {
  background: #F5F6F8;
  color: #4E5969;
}

/* ---------- 音色选择器 ---------- */
.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  background: #F7F8FA;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.arrow {
  color: #C0C4CC;
  font-size: 34rpx;
}

/* ---------- 滑块 ---------- */
.slider-item {
  margin-bottom: 8rpx;
}

.slider-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 27rpx;
  color: #1F2329;
  margin-bottom: 4rpx;
}

.slider-val {
  color: #4B6BFB;
  font-size: 25rpx;
}

/* ---------- 操作与提示 ---------- */
.action-row {
  margin-bottom: 12rpx;
}

.hint {
  font-size: 23rpx;
  color: #A0A6AE;
  line-height: 1.6;
  margin: 0 8rpx 10rpx;
}

/* ---------- 播放器 ---------- */
.progress-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 10rpx 0 20rpx;
}

.time {
  font-size: 22rpx;
  color: #8A9099;
  min-width: 76rpx;
  text-align: center;
}

.seek {
  flex: 1;
  margin: 0;
}

/* ---------- 底部 ---------- */
.footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 8rpx;
}

.footer-link {
  font-size: 27rpx;
  color: #4B6BFB;
}

.footer-server {
  font-size: 22rpx;
  color: #B0B6BE;
}
