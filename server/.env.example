# 复制为 .env 后按需修改
QINGYU_HOST=0.0.0.0
QINGYU_PORT=5000
QINGYU_DEBUG=True

# 默认音色
QINGYU_DEFAULT_VOICE=zh-CN-XiaoxiaoNeural

# 文本与分段
QINGYU_MAX_TEXT_CHARS=20000
QINGYU_SEGMENT_MAX_CHARS=400
QINGYU_PREVIEW_MAX_CHARS=200

# 并发与任务
QINGYU_MAX_WORKERS=3
QINGYU_TASK_TTL=1800
QINGYU_AUDIO_TTL=7200
QINGYU_SYNTH_RETRY=3
QINGYU_SYNTH_TIMEOUT=60

# 跨域（生产环境建议改为小程序域名）
QINGYU_CORS=*
